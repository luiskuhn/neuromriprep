/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

// conf/modules.config

process {

  // Container images are selected centrally from pipeline parameters.
  // Defaults are centralized in nextflow.config; DeepDefacer retains its legacy site path.
  withName: 'DCM2BIDS_CONFIG'       { container = params.dcm2bids_config_container }
  withName: 'DCM2BIDS_OUTPUT_PATCH' { container = params.dcm2bids_output_patch_container }
  withName: 'DCM2BIDS_POSTPROC'     { container = params.dcm2bids_postproc_container }
  withName: 'MERGE_BIDS_DATASET'    { container = params.merge_bids_dataset_container }
  withName: 'BIDSIGNORE'            { container = params.bidsignore_container }
  withName: 'BIDS_VALIDATOR'        { container = params.bidsvalidator_container }
  withName: 'BIDS_QC_GATE'          { container = params.bids_qc_gate_container }
  withName: 'MRIQC_GROUP'           { container = params.mriqc_container ?: params.mriqc_group_container }
  withName: 'DEEPDEFACER'           { container = params.deepdefacer_container }
  withName: 'DEFACE_QC_RENDER'      { container = params.deface_qc_render_container }
  withName: 'DEFACE_METRICS'        { container = params.deface_metrics_container }
  withName: 'DEFACE_DETECTOR'       { container = params.deface_detector_container }
  withName: 'MERGE_BENCHMARK'       { container = params.merge_benchmark_container }

  withName: 'FMRIPREP' {
    container = params.fmriprep_container
    cpus     = 16
    memory   = 60.GB
    maxForks = 3
    errorStrategy = {
      params.ignore_fmriprep_fail
        ? (task.attempt <= 1? 'retry' : 'ignore')
        : 'terminate'
    }
    maxRetries = 1
    maxErrors = -1
  }

  withName: 'MRIQC_PARTICIPANT' {
    container = params.mriqc_container ?: params.mriqc_participant_container
    memory   = 30.GB
    cpus     = 16
    maxForks = 4
    time     = 120.h
  }

  withName: 'DCM2BIDS' {
    container = params.dcm2bids_container
    maxForks = 4
  }

  withName: 'PYDEFACE' {
    container = params.pydeface_container
    maxForks = 4
  }

  withName: 'AFNI_REFACER' {
    container = params.afni_refacer_container
    maxForks = 4
  }

  withName: 'FSL_DEFACE' {
    container = params.fsl_deface_container
    maxForks = 4
  }

  withName: 'MRI_DEFACE' {
    container = params.mri_deface_container
    maxForks = 4
  }

}
