/*
 * Example IRTG clinical site settings.
 * Run with: -profile irtg -c assets/examples/irtg-clinical/site.config
 *
 * This file intentionally leaves the executor to the site's scheduler setup.
 * Uncomment and fill in the executor and queue only after confirming the
 * correct Nextflow executor names with local HPC/clinical IT.
 */

executor.queueSize = 8

// Example only; enable and set the real values for a Slurm deployment:
// process.executor = 'slurm'
// process.queue    = '<approved-clinical-partition>'

process {
    // This task moves staged files during postprocessing; use private task copies.
    withName: 'DCM2BIDS_POSTPROC' {
        stageInMode = 'copy'
    }

    // The process has these IRTG defaults already. Set explicitly here if the
    // site mounts its read-only TemplateFlow cache somewhere else.
    withName: 'FMRIPREP' {
        ext.templateflow_host = '/nic/sw/IRTG/templateflow'
    }
}
